# Scientific JSON is byte-verified by the image/offline pack builders.
# Keep canonical LF bytes on every platform, even with core.autocrlf=true.
public/data/**/*.json text eol=lf
public/data/*.json text eol=lf

# Keep documented install-asset fingerprints stable across Windows checkouts.
public/manifest.webmanifest text eol=lf
public/icons/*.svg text eol=lf

# Coordinator-reviewed submitted excerpt fingerprints use canonical LF.
data/environment/reviewed-excerpt/* text eol=lf

# Preserve uploaded spatial evidence exactly; keep copied labels canonical.
data/imagery/calibrated-source/*.tif binary
data/imagery/calibrated-source/*.txt text eol=lf
